&НаСервере
Процедура ИзменитьФорму()

	СтраницыИзХранилищаЗначений = ПолучитьИзВременногоХранилища(АдресДанныхВременногоХранилища);
	Если СтраницыИзХранилищаЗначений = Неопределено Тогда
		// Если в массиве нет ни одногй страницы
		
	Иначе
		//Если массив страниц существует
		//Создаем ГруппуСтраниц
		ПеременнаяГруппаСтраницы = Элементы.Найти("ГруппаСтраниц");
		Если ПеременнаяГруппаСтраницы = Неопределено Тогда
			ГруппаСтраниц = ДФИ.СздГруппаСтраниц(ЭтотОбъект,"ГруппаСтраниц",ЭтотОбъект,1,1);
			ГруппаСтраниц.РастягиватьПоГоризонтали = Истина;
			//Создаем страницы Массива в первый раз при открытии
			Для  Индекс = 0 ПО СтраницыИзХранилищаЗначений.Количество()-1 Цикл
				ЭлементМассива = СтраницыИзХранилищаЗначений[Индекс];
				
				//Создаем страницы
				КодСтраницы = "Страница" + Строка(Индекс);
				ТекущийЗаголовок = ЭлементМассива.НазваниеСтраницы;
				ЭлементМассива.КодСтраницы = КодСтраницы;
				НоваяСтраница = ДФИ.СздСтраница(ЭтотОбъект,КодСтраницы,ГруппаСтраниц,ТекущийЗаголовок,1,1);
				
				//Создаем группу для поля  - Путь к файлу  и кнопке - Удалить страницу
				НазваниеГруппыДляКнопки = "ГруппаДляКнопки"  + Строка(Индекс);
				ГруппаДляКнопки = ДФИ.СздГруппаОбычнаяБезОтображения(ЭтотОбъект,НазваниеГруппыДляКнопки,КодСтраницы,1);
				ГруппаДляКнопки.РастягиватьПоГоризонтали = Истина;
				ГруппаДляКнопки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
				
				//Создаем Поле и команду в группе
				НазваниеПутиФайла = "ПутьФайла" + Строка(Индекс);
				стрРеквизитов = Новый Структура;
				стрРеквизитов.Вставить(НазваниеПутиФайла,ДФИ.ОписаниеТипаСтрока());
				ДФИ.СоздатьРеквизиты(ЭтотОбъект,стрРеквизитов);
				СобытияПоля = Новый Структура;
				СобытияПоля.Вставить("НачалоВыбора","ПутьКФайлуНачалоВыбора");
				ПолеПутиФайла = ДФИ.СздПоле(ЭтотОбъект,НазваниеПутиФайла,ГруппаДляКнопки,,1,НазваниеПутиФайла,,СобытияПоля);
				ЭтотОбъект[НазваниеПутиФайла] = ЭлементМассива.ФайлОписания;
				ПолеПутиФайла.кнопкаВыбора = Истина;
				ПолеПутиФайла.кнопкаОчистки = Истина;
				ПолеПутиФайла.кнопкаОткрытия = Истина;
				
				//Создаем Кнопку - "Удалитьстраницу"
				НазваниеКоманды = "Команда" + Строка(Индекс);	
				НазваниеКнопки = "Кнопка" + Строка(Индекс);
				ДФИ.СоздатьКоманду(ЭтотОбъект,НазваниеКоманды,"Проверка","УдалитьСтраницу");
				СвойстваКнопки = Новый Структура;
				СвойстваКнопки.Вставить("ГоризонтальноеПоложениеВГруппе",ГоризонтальноеПоложениеЭлемента.Право);  
				НоваяКнопка = ДФИ.СздКнопка(ЭтотОбъект,НазваниеКнопки,ГруппаДляКнопки,"Удалить страницу с описанием",НазваниеКоманды,2,СвойстваКнопки);
							
				//Создаем поле для Текста описания
				НазваниеТекста = "Текст" + Строка(Индекс);
				стрРеквизитов = Новый Структура;
				стрРеквизитов.Вставить(НазваниеТекста,ДФИ.ОписаниеТипаСтрока());
				ДФИ.СоздатьРеквизиты(ЭтотОбъект,стрРеквизитов);
				НовоеПоле = ДФИ.СздПоле(ЭтотОбъект,НазваниеТекста,КодСтраницы,,1,НазваниеТекста);
				НовоеПоле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
				НовоеПоле.Ширина = 150;
				НовоеПоле.МногострочныйРежим = Истина;
				НовоеПоле.РастягиватьПоГоризонтали = Истина;		
				НовоеПоле.РастягиватьПоВертикали = Истина;
				ЭтотОбъект[НазваниеТекста] = ЭлементМассива.ТекстОписания;

								
			КонецЦикла;
		Иначе
			
			//Добавляем страницу к существующим
			ИндексПоследнегоЭлемента = СтраницыИзХранилищаЗначений.ВГраница();
			ПоследнийЭлементМассива = СтраницыИзХранилищаЗначений[ИндексПоследнегоЭлемента];
			Если ИндексПоследнегоЭлемента = 0 Тогда  // Если элементов в массиве 1
				Индекс = 0;
			Иначе
				ПредПоследнийЭлементМассива = СтраницыИзХранилищаЗначений[ИндексПоследнегоЭлемента-1];
				ЦифрыИзНазванияПоследнегоЭлемента = МоиВспомогательные.ПолучитьТолькоЦифрыИзСтроки(ПредПоследнийЭлементМассива.КодСтраницы);
				Индекс = Число(ЦифрыИзНазванияПоследнегоЭлемента)+1;
			КонецЕсли;
			КодСтраницы = "Страница" + Строка(Индекс);
			
			// Проверяем на наличие страницы с таким названием
			СтараяСтраница = Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.Найти(КодСтраницы);
			Если СтараяСтраница = Неопределено Тогда
				ПоследнийЭлементМассива.КодСтраницы = КодСтраницы;
				НоваяСтраница = ДФИ.СздСтраница(ЭтотОбъект,КодСтраницы,"ГруппаСтраниц",ПоследнийЭлементМассива.НазваниеСтраницы,1,1);
				
				//Создаем группу для поля  - Путь к файлу  и кнопке - Удалить страницу
				НазваниеГруппыДляКнопки = "ГруппаДляКнопки"  + Строка(Индекс);
				ГруппаДляКнопки = ДФИ.СздГруппаОбычнаяБезОтображения(ЭтотОбъект,НазваниеГруппыДляКнопки,КодСтраницы,1);
				ГруппаДляКнопки.РастягиватьПоГоризонтали = Истина;
				ГруппаДляКнопки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
								
				//Создаем Поле и команду в группе
				НазваниеПутиФайла = "ПутьФайла" + Строка(Индекс);
				стрРеквизитов = Новый Структура;
				стрРеквизитов.Вставить(НазваниеПутиФайла,ДФИ.ОписаниеТипаСтрока());
				ДФИ.СоздатьРеквизиты(ЭтотОбъект,стрРеквизитов);
				СобытияПоля = Новый Структура;
				СобытияПоля.Вставить("НачалоВыбора","ПутьКФайлуНачалоВыбора");
				ПолеПутиФайла = ДФИ.СздПоле(ЭтотОбъект,НазваниеПутиФайла,ГруппаДляКнопки,,1,НазваниеПутиФайла,,СобытияПоля);
				ЭтотОбъект[НазваниеПутиФайла] = ""; //ЭлементМассива.ФайлОписания;
				ПолеПутиФайла.кнопкаВыбора = Истина;
				ПолеПутиФайла.кнопкаОчистки = Истина;
				ПолеПутиФайла.кнопкаОткрытия = Истина;
				
				НазваниеКоманды = "Команда" + Строка(Индекс);
				ДФИ.СоздатьКоманду(ЭтотОбъект,НазваниеКоманды,"Проверка","УдалитьСтраницу");
				
				НазваниеКнопки = "Кнопка" + Строка(Индекс);
				СвойстваКнопки = Новый Структура;
				СвойстваКнопки.Вставить("ГоризонтальноеПоложениеВГруппе",ГоризонтальноеПоложениеЭлемента.Право);
				ДФИ.СздКнопка(ЭтотОбъект,НазваниеКнопки,ГруппаДляКнопки,"Удалить страницу с описанием",НазваниеКоманды,2,СвойстваКнопки);
				
				НазваниеТекста = "Текст" + Строка(Индекс);
				стрРеквизитов = Новый Структура;
				стрРеквизитов.Вставить(НазваниеТекста,ДФИ.ОписаниеТипаСтрока());
				ДФИ.СоздатьРеквизиты(ЭтотОбъект,стрРеквизитов);
				НовоеПоле = ДФИ.СздПоле(ЭтотОбъект,НазваниеТекста,КодСтраницы,,1,НазваниеТекста);
				НовоеПоле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
				НовоеПоле.Ширина = 150;
				НовоеПоле.МногострочныйРежим = Истина;
				НовоеПоле.РастягиватьПоГоризонтали = Истина;		
				НовоеПоле.РастягиватьПоВертикали = Истина;
				
				Элементы.ГруппаСтраниц.ТекущаяСтраница = НоваяСтраница;
			Иначе  // Есть страница с таким же названием
				ПоследнийЭлементМассива.КодСтраницы = КодСтраницы;
				СтараяСтраница.Заголовок = ПоследнийЭлементМассива.НазваниеСтраницы;
				СтараяСтраница.Видимость = Истина;
				//СтараяСтраница.Имя = КодСтраницы;
				Элементы.ГруппаСтраниц.ТекущаяСтраница = СтараяСтраница;
			КонецЕсли
		КонецЕсли
	КонецЕсли;
	Элементы.ДобавитьОписание.Доступность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтраницу(Команда)
	
	// Сначала находим группу-контейнер
	Контейнер = Элементы.ГруппаСтраниц; //.Страницы.Найти("ИмяВерсии");
	НазваниеТекущейСтраницы = Элементы.группаСтраниц.ТекущаяСтраница.Имя;
	Страница = Контейнер.ПодчиненныеЭлементы.Найти(НазваниеТекущейСтраницы);
	СтраницыИзХранилищаЗначенийНаКлиенте = ПолучитьИзВременногоХранилища(АдресДанныхВременногоХранилища);
	Если Страница <> Неопределено Тогда
    	//Элементы.Удалить(Страница); // Ошибка  - Изменениесоставов Элементов недоступно
    	Страница.Видимость = Ложь;
    КонецЕсли;
	
	
	Для Индекс = 0 по СтраницыИзХранилищаЗначенийНаКлиенте.Вграница() Цикл
		ЭлементМассива = СтраницыИзХранилищаЗначенийНаКлиенте[Индекс];
		Если ЭлементМассива.КодСтраницы = НазваниеТекущейСтраницы Тогда
			
			Если СтраницыИзХранилищаЗначенийНаКлиенте.Количество() = 1 Тогда
				// Если всего одна страница, то удаляем элемент и ничего больше не делаем
				СтраницыИзХранилищаЗначенийНаКлиенте.Удалить(Индекс);
				Прервать;
			ИначеЕсли Индекс >= 0 И Индекс < СтраницыИзХранилищаЗначенийНаКлиенте.ВГраница() Тогда
				// Делаем активной следующую страницу 
				СтраницыИзХранилищаЗначенийНаКлиенте.Удалить(Индекс);
				МассивТекСтраница = СтраницыИзХранилищаЗначенийНаКлиенте[индекс];
				ИмяНовойТекСтраницы = МассивТекСтраница.КодСтраницы;
				НоваяТекСтраница = Контейнер.ПодчиненныеЭлементы.Найти(ИмяНовойТекСтраницы);
				Контейнер.ТекущаяСтраница = НоваяТекСтраница;
				Прервать;
			ИначеЕсли СтраницыИзХранилищаЗначенийНаКлиенте.ВГраница() = индекс  Тогда
				СтраницыИзХранилищаЗначенийНаКлиенте.Удалить(Индекс);
				МассивТекСтраница = СтраницыИзХранилищаЗначенийНаКлиенте[индекс-1];
				ИмяНовойТекСтраницы = МассивТекСтраница.КодСтраницы;
				НоваяТекСтраница = Контейнер.ПодчиненныеЭлементы.Найти(ИмяНовойТекСтраницы);
				Контейнер.ТекущаяСтраница = НоваяТекСтраница;
				Прервать;
			КонецЕсли;
			
			
			Прервать;
			//СледующаяСтраница = Контейнер.ПодчиненныеЭлементы.Найти(ЭлементМассива.НазваниеСтраницы); 
			//Контейнер.текущаяСтраницы = 	
		КонецЕсли;
	КонецЦикла;
	АдресДанныхВременногоХранилища = ПоместитьВоВременноеХранилище(СтраницыИзХранилищаЗначенийНаКлиенте, АдресДанныхВременногоХранилища);
	
//	УдалитьЭлементНаСервере();   // Не работает
	
КонецПроцедуры
#КонецОбласти

