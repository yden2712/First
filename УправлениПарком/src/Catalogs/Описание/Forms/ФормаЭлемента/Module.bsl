	КонецЕсли;
	АдресДанныхВременногоХранилища = ПоместитьВоВременноеХранилище(СтраницыИзХранилищаЗначенийНаКлиенте, АдресДанныхВременногоХранилища);
		//ДобавитьСтраницу();
	ИзменитьФорму();
		//НазваниеСтраницы = Объект.стра
		//НоваяСтраница = ДФИ.СздСтраница(ЭтотОбъект,НазваниеСтраницы,ГруппаСтраниц,Объект.КомментарийРасположение,1,1);
		//ДФИ.СоздатьКоманду(ЭтотОбъект,"ПриветИнфостарт","Проверка","СообщитьПриветИнфостарт");
		//ДФИ.СздКнопка(ЭтотОбъект,"Проверка",НоваяСтраница,"Поздароваться","ПриветИнфостарт",2);
