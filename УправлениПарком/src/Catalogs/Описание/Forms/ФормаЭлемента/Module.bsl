&НаКлиенте
Процедура ПослеВыбораФайла (ВыбранныеФайлы, ДополнительныеПараметры)Экспорт
	
	ОчиститьСообщения();
	Если ВыбранныеФайлы = Неопределено Тогда
		Сообщить("Файл для загрузки не выбран");
		Объект.ПутьКФайлуСтраницы = "";
		Возврат;
	КонецЕсли;
	//
	Контейнер = Элементы.ГруппаСтраниц; //.Страницы.Найти("ИмяВерсии");
	НазваниеТекущейСтраницы = Элементы.группаСтраниц.ТекущаяСтраница.Имя;
	Страница = Контейнер.ПодчиненныеЭлементы.Найти(НазваниеТекущейСтраницы);
	
	Если АдресДанныхВременногоХранилища <> "" Тогда
		СтраницыИзХранилищаЗначенийНаКлиенте = ПолучитьИзВременногоХранилища(АдресДанныхВременногоХранилища);
	КонецЕсли;
	//Вставляем путь к файлу в поле формы
	Для каждого ЭлементМассива из СтраницыИзХранилищаЗначенийНаКлиенте Цикл
		Если Страница.Имя = ЭлементМассива.Кодстраницы Тогда
			ЭлементМассива.ФайлОписания = ВыбранныеФайлы[0];
			ЦифрыИзНазвания = МоиВспомогательные.ПолучитьТолькоЦифрыИзСтроки(Страница.Имя);
			НазваниеПоляСтраницы = "ПутьФайла"+ Строка(ЦифрыИзНазвания);
			//Страница.ПодчиненныеЭлементы[НазваниеПоляСтраницы] = ВыбранныеФайлы[0];
			ЭтотОбъект[НазваниеПоляСтраницы]= ВыбранныеФайлы[0];
		КонецЕсли
	КонецЦикла;
	ПутьКФайлуСтраницы = ВыбранныеФайлы[0];
	//ТекстИЗФайла = МоиВспомогательные.ПрочитатьТекстИзDocx(ВыбранныеФайлы[0]);
	
	
	// Комментарий из вордовских файлов
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ЭтотОбъект[НазваниеПоляСтраницы]); 
	ТекстИзФайла = МоиВспомогательные.ИнициализироватьXMLИзDocx(ДвоичныеДанныеФайла);
	
	АдресДанныхВременногоХранилища = ПоместитьВоВременноеХранилище(СтраницыИзХранилищаЗначенийНаКлиенте, АдресДанныхВременногоХранилища);
КонецПроцедуры







