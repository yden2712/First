Процедура СообщитьПриветИнфостарт(Команда)
//	Сообщение = Новый СообщениеПользователю;
//	Сообщение.Текст = "Привет Инфостарт!";
//	Сообщение.Сообщить();
	//ТекущаяСтраница = Элементы.ГруппаСтраниц.найти;
	//Элементы.Удалить(ТекущаяСтраница);
	
	// Сначала находим группу-контейнер
	Контейнер = Элементы.ГруппаСтраниц; //.Страницы.Найти("ИмяВерсии");
	НазваниеТекущейСтраницы = Элементы.группаСтраниц.ТекущаяСтраница.Имя;
	Страница = Контейнер.ПодчиненныеЭлементы.Найти(НазваниеТекущейСтраницы);
	СтраницыИзХранилищаЗначенийНаКлиенте = ПолучитьИзВременногоХранилища(АдресДанныхВременногоХранилища);
	Если Страница <> Неопределено Тогда
    	//Элементы.Удалить(Страница); // Ошибка  - Изменениесоставов Элементов недоступно
    	Страница.Видимость = Ложь;
    КонецЕсли;
	
	Индекс = 1;
	Для Каждого ЭлементМассива из СтраницыИзХранилищаЗначенийНаКлиенте Цикл
		Если ЭлементМассива.КодСтраницы = НазваниеТекущейСтраницы Тогда
			СтраницыИзХранилищаЗначенийНаКлиенте.Удалить(Индекс);	
		КонецЕсли;
		Индекс = Индекс+1;
	КонецЦикла;
	АдресДанныхВременногоХранилища = ПоместитьВоВременноеХранилище(СтраницыИзХранилищаЗначенийНаКлиенте, АдресДанныхВременногоХранилища);
	
//	УдалитьЭлементНаСервере();   // Не работает
	
КонецПроцедуры
