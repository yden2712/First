	Иначе
		СтраницаИзХЗ = Новый Структура ("КодСтраницы,НазваниеСтраницы, ФайлОписания, ТекстОписания");
		СтраницаИзХЗ.КодСтраницы = "";
		СтраницаИзХЗ.НазваниеСтраницы = Объект.КомментарийРасположение;
