				//ЗаголовокСтраницы = СтраницыИзХранилищаЗначений[ЭлементМассива];
				ТекущийЗаголовок = ЭлементМассива.НазваниеСтраницы;
				ЭлементМассива.КодСтраницы = НазваниеСтраницы;
				НоваяСтраница = ДФИ.СздСтраница(ЭтотОбъект,НазваниеСтраницы,ГруппаСтраниц,ТекущийЗаголовок,1,1);
				
				ДФИ.СоздатьКоманду(ЭтотОбъект,НазваниеКоманды,"Проверка","СообщитьПриветИнфостарт");
				ДФИ.СздКнопка(ЭтотОбъект,НазваниеКнопки,НазваниеСтраницы,"Удалить",НазваниеКоманды,2);
				//Сообщить("Привет"); 
				СчетчикСтраниц = СчетчикСтраниц + 1;
				СчетчикКоманд = СчетчикКоманд + 1;
				СчетчикКнопки = СчетчикКнопки + 1;
				НазваниеСтраницы = "Страница" + Строка(СчетчикСтраниц);
				НазваниеКоманды = "Команда" + Строка(СчетчикКоманд);
				НазваниеКнопки = "Кнопка" + Строка(СчетчикКнопки);
			КонецЦикла;
		Иначе
			
			//Добавляем страницу к существующим
			ИндексПоследнегоЭлемента = СтраницыИзХранилищаЗначений.ВГраница()-1;
			ПоследнийЭлементМассива = СтраницыИзХранилищаЗначений[ИндексПоследнегоЭлемента];
			ЦифрыИзНазванияПоследнегоЭлемента = МоиВспомогательные.ПолучитьТолькоЦифрыИзСтроки(ПоследнийЭлементМассива.КодСтраницы);
			//СчетчикСтраниц = СтраницыИзХранилищаЗначений.Количество();
			СчетчикКоманд = СтраницыИзХранилищаЗначений.Количество();
			СчетчикКнопки = СтраницыИзХранилищаЗначений.Количество();
			НазваниеСтраницы = "Страница" + Строка(ЦифрыИзНазванияПоследнегоЭлемента + 1);
			НазваниеКоманды = "Команда" + Строка(СчетчикКоманд);
			НазваниеКнопки = "Кнопка" + Строка(СчетчикКнопки); 
			
			НоваяСтраница = ДФИ.СздСтраница(ЭтотОбъект,НазваниеСтраницы,"ГруппаСтраниц",Объект.КомментарийРасположение,1,1);
				
			ДФИ.СоздатьКоманду(ЭтотОбъект,НазваниеКоманды,"Проверка","СообщитьПриветИнфостарт");
			ДФИ.СздКнопка(ЭтотОбъект,НазваниеКнопки,НазваниеСтраницы,"Удалить",НазваниеКоманды,2);
		КонецЕсли
	КонецЕсли;
	//АдресДанныхВременногоХранилища = ПоместитьВоВременноеХранилище(СтраницыИзХранилищаЗначенийНаКлиенте, АдресДанныхВременногоХранилища);
	
	
	
	
	
	
	
	
	Элементы.ПутьКФайлуСтраницы.Видимость= Ложь;
	//Элементы.СтраницаГлавная.Видимость = Ложь;
	Элементы.ДобавитьОисание.Доступность = Ложь;
	
КонецПроцедуры

