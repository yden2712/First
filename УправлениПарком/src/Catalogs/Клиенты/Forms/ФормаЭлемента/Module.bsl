&НаСервере
Процедура ПереносТелефонаИзРеквизитовВКонтактфБСПНаСервере()
	
	
	//ПараметрыОбработки.ОбработкаЗавершена = Ложь;
	
	ВидКИТелефонаКлиента = УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("ТелефонКлиента");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Клиенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Клиенты КАК Клиенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Клиенты.КонтактнаяИнформация КАК КлиентыКонтактнаяИнформация
		|		ПО КлиентыКонтактнаяИнформация.Ссылка = Клиенты.Ссылка
		|		И КлиентыКонтактнаяИнформация.Вид = &ВидКИТелефонаКлиента
		|ГДЕ
		|	Клиенты.НормализованныйТелефон <> """"
		|	И КлиентыКонтактнаяИнформация.Ссылка ЕСТЬ NULL";
		
	Запрос.УстановитьПараметр("ВидКИТелефонаКлиента", ВидКИТелефонаКлиента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой()Тогда
		//ПараметрыОбработки.ОбработкаЗавершена = Истина;	
		Возврат;
	КонецЕсли; 
	
	//РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СпрОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		КонтактнаяИнформация = УправлениеКонтактнойИнформацией.НоваяКонтактнаяИнформация();
		НоваяСтрока = КонтактнаяИнформация.Добавить();
		НоваяСтрока.Вид = ВидКИТелефонаКлиента;
				
		//СпрОбъект.УдалитьТелефон = "";
		
		//НомерТелефонаКИ = "";
		ВидКИ = УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("ТелефонКлиента");
		Для Каждого Строка Из КонтактнаяИнформация Цикл
			Если Строка.Вид = ВидКИ Тогда
				НоваяСтрока.Представление = СпрОбъект.НормализованныйТелефон;
			КонецЕсли;			
		КонецЦикла;
		
		НоваяСтрока.Объект = СпрОбъект;
		УправлениеКонтактнойИнформацией.УстановитьКонтактнуюИнформациюОбъекта(СпрОбъект, КонтактнаяИнформация, Ложь);
		//ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СпрОбъект);
		СпрОбъект.Записать();

	КонецЦикла;
	
КонецПроцедуры
